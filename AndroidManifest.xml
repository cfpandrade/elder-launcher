<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.cfpandrade.elderlauncher"
    android:versionCode="3"
    android:versionName="2.1.0">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="30" />

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- a configured number missing from the address book is added, otherwise WhatsApp cannot call it -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- optional remote configuration -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- granted over ADB, only for the optional power menu guard and wireless debugging keep-alive -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- granted over ADB (appops): brightness and screen timeout -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- to show the incoming call screen from the background, on top of everything -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.android.camera" />
        <package android:name="com.android.contacts" />
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode|fontScale|density"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="io.github.cfpandrade.elderlauncher.call"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".VideoActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.cfpandrade.elderlauncher.video"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <activity
            android:name=".LookingForYouActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="io.github.cfpandrade.elderlauncher.looking"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".MessageActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="io.github.cfpandrade.elderlauncher.message"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- exported so other apps (Home Assistant's companion app, ADB) can send commands; see README -->
        <receiver android:name=".CommandReceiver" android:exported="true">
            <intent-filter>
                <action android:name="io.github.cfpandrade.elderlauncher.VIDEO" />
                <action android:name="io.github.cfpandrade.elderlauncher.STOP" />
                <action android:name="io.github.cfpandrade.elderlauncher.MEDIA" />
                <action android:name="io.github.cfpandrade.elderlauncher.MESSAGE" />
            </intent-filter>
        </receiver>

        <receiver android:name=".SettingsReceiver" android:exported="true">
            <intent-filter>
                <action android:name="io.github.cfpandrade.elderlauncher.SETTING" />
            </intent-filter>
        </receiver>

        <service
            android:name=".PowerMenuGuard"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/power_menu_guard" />
        </service>

        <!-- only ADB can use it: the installer hands over contacts, photos and the server address -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="io.github.cfpandrade.elderlauncher.config"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <service
            android:name=".CallWatcherService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
